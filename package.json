{
	"name": "w3gv",
	"version": "0.1.0",
	"description": "WC3 Replay Simulator",
	"scripts": {
		"build:parser": "node tools/build-parser-bundle.js",
		"gen-builds-cards": "node tools/gen-builds-cards.js",
		"gen-manifest": "node tools/gen-asset-manifest.js",
		"check-manifest": "node tools/gen-asset-manifest.js --check",
		"desktop": "node tools/build-desktop-client.js --bundle-maps=ladder && cd desktop/src-tauri && cargo tauri dev",
		"desktop:build": "node tools/build-desktop-client.js --bundle-maps=ladder && cd desktop/src-tauri && cargo tauri build",
		"desktop:test": "node tools/test-profile-aggregate.js && node tools/test-game-report.js && node tools/test-backfill-catchup.js && cargo test --manifest-path desktop/src-tauri/Cargo.toml --release"
	},
	"devDependencies": {
		"@gltf-transform/core": "^4.4.0",
		"assert": "^2.1.0",
		"browserify-zlib": "^0.2.0",
		"buffer": "^6.0.3",
		"crypto-browserify": "^3.12.1",
		"esbuild": "^0.25.0",
		"events": "^3.3.0",
		"fflate": "^0.8.2",
		"gltf-validator": "^2.0.0-dev.3.10",
		"pako": "^1.0.11",
		"path-browserify": "^1.0.1",
		"process": "^0.11.10",
		"sharp": "^0.35.3",
		"stream-browserify": "^3.0.0",
		"util": "^0.12.5"
	},
	"keywords": [
		"w3g",
		"julas",
		"replay",
		"warcraft",
		"warcraft iii",
		"warcraft 3",
		"wc3"
	],
	"author": {
		"name": "Jeff Blanchette",
		"email": "jeff.blanchette5@gmail.com"
	},
	"contributors": [],
	"dependencies": {
		"@wowserhq/stormjs": "^0.4.1",
		"canvas": "^3.2.1",
		"d3": "^5.12.0",
		"image-js": "^0.33.1",
		"image-size": "^0.9.1",
		"pngjs": "^6.0.0",
		"rbush": "^3.0.1",
		"w3gjs": "3.0.0",
		"war3-model": "^4.0.1"
	},
	"license": "GNU v3.0",
	"readmeFilename": "README.md"
}
