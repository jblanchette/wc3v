{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WC3V",
  "version": "0.7.4",
  "identifier": "com.wc3v.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "WC3V",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "decorations": false,
        "backgroundColor": "#12131f"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: https://cdn.wc3v.com",
        "connect-src": "'self' ipc: http://ipc.localhost"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "resources": ["resources/maps/**/*"],
    "createUpdaterArtifacts": true,
    "shortDescription": "Local WC3 replay auto-parse and overlay",
    "longDescription": "Watches your Warcraft III replay folders, parses each game locally the moment it finishes, and drives an OBS-ready overlay. No accounts, no telemetry, no game injection."
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://cdn.wc3v.com/desktop/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI5N0E3RDEzMUQzNzQwOUQKUldTZFFEY2RFMzE2S1NTNnM2QUFOcitLSW81UXJQeUx3VjBWRCtEalUrenFtSG5yT3Z2dGV1aVMK"
    }
  }
}
