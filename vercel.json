{
  "version": 2,
  "redirects": [
    { "source": "/builds", "destination": "/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/",              "destination": "/client/index.html"          },
    { "source": "/viewer",        "destination": "/client/viewer.html"         },
    { "source": "/replays/:name", "destination": "/client/replays/:name.gz"   },
    { "source": "/js/:path*",     "destination": "/client/js/:path*"           },
    { "source": "/css/:path*",    "destination": "/client/css/:path*"          },
    { "source": "/compare.html",  "destination": "/client/compare.html"        },
    { "source": "/compare",       "destination": "/client/compare.html"        },
    { "source": "/about.html",    "destination": "/client/about.html"          },
    { "source": "/replays.html",  "destination": "/client/replays.html"        },
    { "source": "/replays",       "destination": "/client/replays.html"        },
    { "source": "/maps/:path*",   "destination": "/client/maps/:path*"         },
    { "source": "/assets/:path*",  "destination": "/client/assets/:path*"       },
    { "source": "/data/:path*",   "destination": "/client/data/:path*"         }
  ],
  "headers": [
    {
      "source": "/replays/(.*)",
      "headers": [
        { "key": "Content-Encoding", "value": "gzip"             },
        { "key": "Content-Type",     "value": "application/json" }
      ]
    }
  ]
}
