node_modules/*
client/logs/
client/replays/*
*.sublime-workspace

# Generated at deploy time by tools/gen-asset-manifest.js (Render buildCommand).
client/asset-manifest.json

client/assets/wc3icons/*
client/assets/models/*
client/assets/textures/*
client/assets/terrain/*

client/maps/
mapdata/
replays/old/
client/replays/old/
client/data/summaries/old/

# Source replay files — kept locally for re-parsing only, never committed.
# Production uses parsed .wc3v.gz served from R2 (cdn.wc3v.com).
replays/*.w3g
replays/*.wc3v
replays/*.wc3v.gz

# Import folder (keep example, ignore actual imports)
replays/import/*.w3g
replays/import/import.json

# ── Bulk corpus ingest — LOCAL ONLY, never published ────────────────────────
# The whole corpus acquisition/indexing toolchain stays on the local machine
# and out of the public repo. Nothing tracked may `require` any of these:
# lib/PlayerManager.js's mapAliases load is wrapped in try/catch precisely so
# a clean checkout behaves exactly as it did before.
tools/crawl-w3i.js
tools/crawl-ingest.js
tools/corpus-batch.js
tools/corpus-db.js
tools/corpus-coverage.js
tools/corpus-to-site.js
tools/build-meta-evidence.js
tools/scaffold-build.js
tools/gen-corpus-stats.js
tools/gen-map-aliases.js
tools/lib/map-coverage.js
tools/lib/w3i-api.js
tools/lib/replay-peek.js
tools/lib/parse-pool.js
helpers/mapAliases.json

# Working data: staged .w3g/.nwg, the crawl journal, the ingest decision log,
# crawler state, the derived SQLite index, and the generated aggregates.
# data/ is ignored WHOLESALE — an earlier version listed only corpus.db* and
# `git add -A` promptly offered to stage nine data/stats/*.json files.
crawl/
# Anchored to the repo root ON PURPOSE. Unanchored, `data/` also swallowed
# client/data/ — the shipped site data. The 345 files already tracked there
# predate the rule, so the breakage was invisible until a NEW generated file
# (site-stats.json) silently refused to stage.
/data/
# The pre-regeneration summaries, kept on disk as a reference. Not shipped.
client/data/summaries/old/

tools/map-data/

marketing/raw/

tools/upgrade-data/
tools/ability-data/
slk/UnitBalance*
helpers/UnitBalance*

__pycache__/
CLAUDE.md
.claude/
.claude*
**/.claude/
claude.md
claude-*.md
*.claude
.claude-*

# Local calibration reference screenshots (not source)
reference-shots/

# Engine-truth capture screenshots (fixtures are the committed artifact)
debug/captures/

# Desktop app build artifacts. desktop/dist is assembled by
# tools/build-desktop-client.js from desktop/src-frontend + the committed
# parser bundle; src-tauri/target is the Rust build dir.
desktop/dist/
# tools/desktop-preview.js output. Deliberately outside dist so it can never be
# bundled into the installer by frontendDist.
desktop/preview/
desktop/src-tauri/target/
desktop/src-tauri/gen/schemas/
# Map parse-data staged into the installer by --bundle-maps. Generated from
# client/maps; ~25 MB for the ladder set and no reason to version it twice.
desktop/src-tauri/resources/

# Update-signing private keys. The PUBLIC key belongs in tauri.conf.json;
# a private key must never enter the repo. Real key lives in ~/.tauri/.
*.key
!**/public.key

# Per-run output of tools/reparse-all.js (batch status + morph counts).
# Regenerated on every run; never meaningful to share.
tools/.reparse-report.json

# Scratch capture frames for tools/build-hero-webp.js. Only the assembled
# client/assets/hero/*.webp outputs are committed.
tools/hero-frames/
.report-shots/
.overlay-shots*/
client/review/
client/assets/press/

# security.txt carries a rolling Expires (build time + 364 days), so it is
# regenerated on every deploy by tools/gen-seo.js. Committing it would make
# `gen-seo --check` fail daily and add pure diff noise. Everything else gen-seo
# emits IS committed, so the generated output stays reviewable.
client/.well-known/security.txt

# Secrets. Never commit credentials. The Cloudflare API token lives OUTSIDE
# this repo at ~/.wc3v/cloudflare.env (user-only ACL) precisely so a stray
# `git add -A` cannot pick it up; these patterns are belt-and-braces for
# anything that does land in the tree.
.env
.env.*
*.env
!seo/copy/*.env
.secrets/
*.token
cloudflare.env
.page-shots/
